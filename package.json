{
  "name": "bitora-commander",
  "productName": "Bitora Commander",
  "version": "2.1.0",
  "description": "Двухпанельный файловый менеджер для Windows",
  "author": "Bitora",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "basic-ftp": "6.2.3",
    "ssh2-sftp-client": "12.1.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "ftp-srv": "4.6.3"
  },
  "build": {
    "appId": "com.bitora.commander",
    "productName": "Bitora Commander",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "assets/**",
      "qa/functional.cjs",
      "LICENSE"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": true,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bitora Commander",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "artifactName": "Bitora-Commander-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Bitora-Commander-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "tools/7zip",
        "to": "tools/7zip",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
